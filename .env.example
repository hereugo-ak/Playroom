# Playroom — Supabase configuration
# Copy to .env.local (never commit .env.local) and fill in with the values from
# Supabase → Project Settings → API.
#
# Use the Publishable key (sb_publishable_…) when the project offers one,
# otherwise the legacy anon key (eyJ…). Both are designed for browser use and
# are protected by Row Level Security. NEVER put a service_role / secret key
# in this file or anywhere else in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Newer Supabase projects call this a “publishable key” (sb_publishable_…).
# The app accepts either variable name; use one, not both:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Optional: only needed if a deployment is served under a sub-path.
# Leave empty for https://playrooom.vercel.app and http://localhost:5173.
# VITE_BASE_PATH=/
